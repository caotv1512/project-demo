# Mau cau hinh - file NAY duoc commit len Git.
# Copy thanh .env roi dien gia tri that; .env KHONG BAO GIO duoc commit.

# Anh image da day len Registry o Session 08 (dung tag co dinh, tranh latest)
IMAGE_REF=ghcr.io/caotv1512/user-service:1.0.0

# Cong mo ra tren VPS, chi bind 127.0.0.1
APP_PORT=8081

# Thong tin database - tren VPS that phai doi thanh mat khau manh
DB_NAME=quickbite_user_db
DB_USERNAME=quickbite_user
DB_PASSWORD=doi-mat-khau-nay-tren-vps-that
